NODE_ENV=development
PORT=5000

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ast?schema=public

# JWT
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Set to 1 when running behind a reverse proxy (Nginx, Render, Railway...)
# TRUST_PROXY=1
AI_SERVICE_URL = http://smart-asset-ai-production.up.railway.app
